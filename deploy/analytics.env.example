# Modele de fichier d'environnement pour le service systemd.
# Sur le VPS : copier vers /etc/resilience-976/analytics.env et completer.
# Ne pas versionner la copie remplie si elle contient un domaine non public.

HOST=127.0.0.1
PORT=8787
ANALYTICS_DATA_FILE=/var/www/resilience-976/server/data/events.jsonl
RESILIENCE_DATABASE_FILE=/var/www/resilience-976/server/data/resilience.sqlite

# Meme-origine une fois derriere nginx : mettre le(s) domaine(s) publics reels.
# Inclure la variante www si le site y est aussi accessible.
ANALYTICS_ALLOWED_ORIGINS=https://DOMAINE_A_REMPLACER,https://www.DOMAINE_A_REMPLACER

# Jeton exige sur les routes d exploitation (tableau de bord, graphe et
# profils de visiteurs, statistiques). Vide = routes ouvertes, ce qui expose
# les reponses au diagnostic de chaque visiteur : a remplir en production.
# Le navigateur, lui, passe par auth_basic cote nginx ; ce jeton sert aux
# appels de script et ferme la porte si la configuration nginx est ecrasee.
ANALYTICS_READ_TOKEN=

# Assistant de liens vers le contenu du site (Hugging Face Inference
# Providers, tier gratuit). Cle personnelle avec la permission "Inference
# Providers" :
# https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
# Sans cette variable, l'endpoint repond 503.
HF_TOKEN=
# Modele par defaut : Qwen/Qwen2.5-7B-Instruct (correct en francais, tier gratuit).
# HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct

# Nombre maximal d'appels a l'assistant de liens par IP et par minute.
# CONTENT_LINKS_RATE_LIMIT=20
# Nombre maximal d'ecritures (evenements, feedback, resultats) par IP et par
# minute, tous endpoints confondus. Large par defaut : une session de groupe
# (atelier, classe) partage une seule IP publique et cumule vite les
# evenements. A ne baisser qu'en cas d'abus constate.
# WRITE_RATE_LIMIT=600
