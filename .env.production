# Charge automatiquement par `vite build` (mode production).
# Aucun secret ici : uniquement des chemins relatifs, corrects que le site
# tourne derriere le nginx du VPS (meme-origine pour /api/*).
VITE_ANALYTICS_ENABLED=true
VITE_ANALYTICS_ENDPOINT=/api/events
VITE_DASHBOARD_ENDPOINT=/api/dashboard
VITE_FEEDBACK_ENDPOINT=/api/feedback
VITE_FEEDBACK_STATS_ENDPOINT=/api/feedback/stats
VITE_DIAGNOSTIC_SYNC_ENDPOINT=/api/diagnostic-responses
VITE_DIAGNOSTIC_STATS_ENDPOINT=/api/diagnostic-responses/stats
