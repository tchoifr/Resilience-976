{
  "name": "resilience-976",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "analytics:server": "node --env-file-if-exists=.env server/analytics-server.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "type-check": "vue-tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "quality": "npm run lint && npm run type-check && npm run test:unit && npm run build",
    "quality:full": "npm run quality && npm run test:e2e",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "seo:campaign-links": "node scripts/generate-campaign-links.mjs",
    "docs:raf-pdf": "node scripts/generate-raf-pdf.mjs",
    "feedback:export": "node scripts/export-feedback.mjs",
    "i18n:check": "node scripts/check-translations.mjs"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.32.0",
    "eslint-plugin-vue": "^10.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.4"
  }
}
